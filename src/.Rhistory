install.packages("ggplot2")
install.packages("ggplot")
library("ggplot2")
data2016_25 %>%
group_by(case_number) %>%
summarise(incident_primary = n(), .groups = "drop") %>%
ggplot(aes(x = case_number, y = incident_primary)) +
geom_line() +
geom_point() +
labs(
title = "Incidents by Year",
x = "Year",
y = "Number of Incidents"
) +
theme_minimal()
